{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,

    // The Worker runs on workerd, not in a browser: no DOM, and the runtime
    // globals (fetch/Response/caches.default/ExecutionContext) come from
    // @cloudflare/workers-types instead.
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/worker.ts"]
}