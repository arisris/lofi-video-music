{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,

    // The Worker runs on workerd, not in a browser: no DOM here, and the
    // runtime globals (fetch/Response/caches.default/ExecutionContext) come
    // from @cloudflare/workers-types instead. Those two worlds cannot share a
    // program - DOM also declares `caches`, but as a CacheStorage without
    // `.default`. Keeping this tsconfig next to the source makes editors pick
    // it automatically, since they bind a file to the closest tsconfig.json.
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["index.ts"]
}