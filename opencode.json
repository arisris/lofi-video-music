{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "@playwright/mcp@latest",
          "--browser",
          "chrome",
          "--executable-path",
          "/usr/bin/brave",
          "--viewport-size",
          "1280,720"
        ]
      }
    }
  }
}
