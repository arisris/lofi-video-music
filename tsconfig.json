{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",

    // Type safety across the whole browser app. The Cloudflare Worker lives
    // in ./worker with its own tsconfig.json, so it falls outside this
    // program - its runtime types conflict with the DOM lib below.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
