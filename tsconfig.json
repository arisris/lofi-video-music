{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsc/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",

    // Type safety across the whole src tree. The browser app is checked here;
    // the Cloudflare Worker is a separate program (tsconfig.worker.json)
    // because its runtime types conflict with the DOM lib.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": ["src/worker.ts"],
  "references": [{ "path": "./tsconfig.worker.json" }]
}
